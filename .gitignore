# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Stray credential files (must never be committed)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# misc
.DS_Store
*.pem

# editor configs (user-specific)
.cursor/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# python
__pycache__/
*.py[cod]

# data-pipeline
# Cached HTML from the WDMMA scraper. This is a politeness cache so re-runs do
# not re-request the site; it is regenerable and must not be committed.
data-pipeline/data/wdmma_cache/

# Raw ingested datasets are multi-GB and regenerable — only curated payloads
# used for ingestion replay are kept in git.
data-pipeline/data/*
!data-pipeline/data/hiik_2025_ingestion_payload.json
!data-pipeline/data/hiik_2025_conflicts.csv
!data-pipeline/data/navbase_fleetlist.json

# Local Supabase CLI binary (vendored, 41 MB, machine-specific)
/supabase-cli

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
